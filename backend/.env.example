# ============================================================
# KINVENTORY — Variables de Entorno
# Copiar como .env y configurar valores reales
# ============================================================

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kinventory
DB_USER=root
DB_PASSWORD=tu_contrasena_aqui
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=kinventory_clave_secreta_muy_larga_cambiar_en_produccion
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=kinventory_refresh_clave_secreta_cambiar
JWT_REFRESH_EXPIRES_IN=7d

# Email (para alertas de stock bajo)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password
MAIL_FROM=Kinventory <noreply@kinventory.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
